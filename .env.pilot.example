# Copy to .env.pilot and fill real values. Never commit .env.pilot.

# Public URL of the app. For local pilot test: http://localhost:8081
# Auth0 callback must be exactly: <APP_BASE_URL>/login/oauth2/code/auth0
APP_BASE_URL=http://localhost:8081
SERVER_PORT=8081

# PostgreSQL. For local pilot test, reuse docker compose:
DB_URL=jdbc:postgresql://localhost:5433/taphoa
DB_USER=taphoa
DB_PASSWORD=taphoa

# Auth0 Regular Web Application (Google connection enabled)
AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret

# SMTP. For local pilot test with Mailpit: auth=false, starttls=false, port=1025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false

# S3-compatible object storage. For local pilot test, S3Mock is on 9090.
S3_ENABLED=true
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY=foo
S3_SECRET_KEY=bar
S3_BUCKET=taphoa
S3_REGION=us-east-1
